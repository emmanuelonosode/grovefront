# Django backend base URL — no trailing slash
# Dev:        http://localhost:8000
# Production: https://admin.primefamilyhousing.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Search Console HTML-tag verification token (content= value).
# This is a static <meta> tag only — NOT a tracking script.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics is first-party only (native telemetry → /api/v1/analytics/visitors/).
# No Google Analytics/GTM and no Meta Pixel — intentionally removed for speed
# and privacy. Do not re-add third-party tracking IDs here.
